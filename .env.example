# Guacamole 버전
GUAC_VERSION=1.6.0

# PostgreSQL 접속 정보 (setup.sh 실행 시 비밀번호가 자동 생성됩니다)
POSTGRES_DB=guacamole_db
POSTGRES_USER=guacamole_user
POSTGRES_PASSWORD=CHANGE_ME

# 외부 공개 포트
HTTP_PORT=80
HTTPS_PORT=443

# 인증서 CN (도메인 또는 서버 IP)
SERVER_NAME=localhost

# 2단계 인증(TOTP) 사용 여부: true / false
TOTP_ENABLED=true

# 브루트포스 차단: 허용 실패 횟수 / 차단 시간(초)
BAN_MAX_INVALID_ATTEMPTS=5
BAN_ADDRESS_DURATION=300
